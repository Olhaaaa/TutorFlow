# Скопіювати в .env і за потреби змінити. .env у git не потрапляє.
DATABASE_URL=postgres://tutorflow:tutorflow@localhost:5432/tutorflow
PORT=8080
JWT_SECRET=dev-only-change-me
TEACHER_TIMEZONE=Europe/Kyiv

# Запасний токен еквайрингу monobank на рівні РОЗГОРТАННЯ. Без нього й без
# власного підключення викладача платіжні маршрути віддають 409, решта працює.
# Тестовий токен береться на https://api.monobank.ua/ (розділ еквайрингу).
MONOBANK_TOKEN=
# Зовнішня адреса застосунку: куди повертати користувача зі сторінки оплати й
# куди надсилати вебхук. У розробці — http://localhost:5173 (порт Vite): вебхук
# на локальну адресу не замовляється, статус добирається опитуванням провайдера.
# Для справжнього вебхука потрібна адреса на https: Cloud Run або тунель.
# У розгортанні на Render задавати не треба — застосунок візьме адресу з
# RENDER_EXTERNAL_URL, яку платформа підставляє сама.
PUBLIC_BASE_URL=
# Ключ шифрування платіжних токенів викладачів (будь-яка довга фраза).
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYMENT_TOKEN_KEY=
# Як часто застосовувати переходи станів за часом, секунди (0 — вимкнути).
MAINTENANCE_INTERVAL_SEC=300
# Чи робить переходи станів сам процес API. Потрібно там, де немає воркера:
# у компоузі лаби 2 лишати порожнім, у розгортанні з одним процесом — true.
MAINTENANCE_IN_API=

# Токен бота Telegram від @BotFather. Без нього канал нагадувань вимкнений:
# вони зберігаються в журналі й видно їх у лозі воркера. Публічна адреса не
# потрібна — бот працює на long polling.
TELEGRAM_BOT_TOKEN=

# ─────────────────── лабораторна 3: пʼять сервісів ───────────────────
#
# Нічого з цього не потрібне ні моноліту, ні компоузу лаби 2. У компоузі лаби 3
# адреси сусідів і базу кожного сервіса задає сам compose-файл — тут вони лише
# для запуску сервіса руками, наприклад щоб подивитись його під відладчиком.

# Спільний секрет внутрішніх маршрутів /internal. Не замінює автентифікацію
# користувача (її робить токен), а відповідає на інше питання: чи прийшов
# запрос від сусіднього сервіса. Порожнє значення лишає маршрути відкритими —
# так зручно дивитись їх curl-ом локально.
INTERNAL_TOKEN=
# Адреси сусідів. Потрібна кожному лише та, яку він справді кличе.
IDENTITY_URL=
SCHEDULING_URL=
BILLING_URL=
NOTIFICATIONS_URL=
# Крок дренажу журналу відкладених доставок у воркері, мілісекунди. Це не
# частота доставки — доставляє той процес, який зробив коміт, одразу. Це
# частота, з якою підбирається те, що з першої спроби не доїхало.
OUTBOX_INTERVAL_MS=2000
# Таймаут внутрішнього виклику, мілісекунди. Довше чекати немає за чим: є повтор.
INTERNAL_TIMEOUT_MS=3000
# Порт, на якому gateway публікується назовні (решта сервісів портів не
# публікує взагалі).
GATEWAY_PORT=8083
# Чотири бази для скиду демо-даних: `node dist/lab3/reset.js` наповнює їх
# однаково, бо посилання між сервісами тримаються на однакових ідентифікаторах.
DATABASE_URL_IDENTITY=
DATABASE_URL_SCHEDULING=
DATABASE_URL_BILLING=
DATABASE_URL_NOTIFICATIONS=
