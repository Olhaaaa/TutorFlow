# Скопіювати в .env і за потреби змінити. .env у git не потрапляє.
DATABASE_URL=postgres://tutorflow:tutorflow@localhost:5432/tutorflow
PORT=8080
JWT_SECRET=dev-only-change-me
TEACHER_TIMEZONE=Europe/Kyiv

# Запасний токен еквайрингу monobank на рівні РОЗГОРТАННЯ. Без нього й без
# власного підключення викладача платіжні маршрути віддають 409, решта працює.
# Тестовий токен береться на https://api.monobank.ua/ (розділ еквайрингу).
MONOBANK_TOKEN=
# Зовнішня адреса застосунку: куди повертати користувача зі сторінки оплати й
# куди надсилати вебхук. У розробці — http://localhost:5173 (порт Vite): вебхук
# на локальну адресу не замовляється, статус добирається опитуванням провайдера.
# Для справжнього вебхука потрібна адреса на https: Cloud Run або тунель.
PUBLIC_BASE_URL=
# Ключ шифрування платіжних токенів викладачів (будь-яка довга фраза).
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYMENT_TOKEN_KEY=
# Як часто застосовувати переходи станів за часом, секунди (0 — вимкнути).
MAINTENANCE_INTERVAL_SEC=300
