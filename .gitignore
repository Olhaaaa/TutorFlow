# Залежності та збірки.
#
# Без скісної риски навмисно: `node_modules/` ловить лише КАТАЛОГ, тому
# символьне посилання з такою самою назвою — а його робить будь-яке
# риштування, що перевіряє збірку в окремому клоні, — проходило мимо правила
# й потрапляло в коміт. Один раз так і сталось.
node_modules
dist
build
coverage
.pnpm-store

# збірка фронтенду, яку віддає Nest
services/api/static/

# секрети — ніколи не комітити
.env
.env.*
!.env.example
*.pem
*-key.json

# IDE
.idea/
*.iml
.vscode/

# логи та службове
*.log
.DS_Store

# чернетки й службові файли — у коміти не йдуть
/docs/*
# ADR-и — виняток: рішення мусять лежати поряд із кодом, який вони описують,
# і бути видні в історії разом із ним
!/docs/adr/
CLAUDE.md
.claude/
/compose.dev.yml.local

# артефакти збірки
*.tsbuildinfo

# Terraform: стан містить згенеровані секрети (паролі БД, JWT_SECRET),
# tfvars — токени. Приклад змінних комітиться.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example
infra/terraform/.terraform.tfstate.lock.info
