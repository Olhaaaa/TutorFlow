# Скопіювати в terraform.tfvars і вписати свій project_id.
# terraform.tfvars у git не йде — там можуть лежати токени.

project_id = "tutorflow-123456"

# region = "europe-central2"
# zone   = "europe-central2-a"

# Мікросервіси (лаба 3) додаються сюди ж окремим ключем — той самий кластер і
# той самий інстанс SQL, свій namespace, свої бази, своя адреса:
#
# environments = {
#   monolith = {
#     namespace = "tutorflow"
#     databases = ["tutorflow"]
#   }
#   microservices = {
#     namespace = "tutorflow-ms"
#     # Рівно ті чотири, що в lab3-microservices/compose.yml: кожна стане
#     # DATABASE_URL_<ІМ'Я> у секреті, а чарт tutorflow-ms роздасть їх сервісам.
#     databases = ["identity", "scheduling", "billing", "notifications"]
#     # domain = "tutor-flow-ms.duckdns.org"
#   }
# }

# Свій бот на кожне середовище, від @BotFather. Необов'язково.
# telegram_bot_tokens = {
#   monolith = "123456:ABC..."
# }

# Пошта: підтвердження реєстрації, відновлення пароля, сповіщення про зміну.
# Один рядок підключення на середовище. БЕЗ нього застосунок працює, а листи
# пишуться в лог контейнера (kubectl logs) — цього досить, щоб показати
# реєстрацію, але не досить, щоб людина отримала посилання.
#
# Порт 25 у Google Cloud заблокований назавжди — беріть 587 (STARTTLS) або
# 465 (TLS одразу). Спецсимволи в паролі екранувати відсотками: @ → %40.
#
# smtp_urls = {
#   monolith      = "smtp://логін:ключ@smtp-relay.brevo.com:587"
#   microservices = "smtp://логін:ключ@smtp-relay.brevo.com:587"
# }
#
# Відправник (MAIL_FROM) задається НЕ тут, а в Helm: app.mailFrom у
# infra/helm/tutorflow/values.yaml і infra/helm/tutorflow-ms/values.yaml.
# Він не секрет, тому живе в конфігмапі поряд з рештою налаштувань. Адреса
# має бути підтверджена в кабінеті провайдера: для duckdns-доменів SPF не
# налаштувати, тому власний домен у відправнику не спрацює.
